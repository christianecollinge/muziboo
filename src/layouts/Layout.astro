---
import "../styles/global.css";
import { SITE } from "../config/site.mjs";
import type { SEOProps } from "../types/seo";
import PostHog from "../components/posthog.astro";

interface Props extends SEOProps {
	lang?: string;
}

const {
	title = SITE.title,
	description = SITE.description,
	canonicalURL,
	ogTitle = title,
	ogDescription = description,
	ogImage = SITE.ogImage,
	ogType = "website",
	twitterCard = "summary_large_image",
	twitterTitle = ogTitle,
	twitterDescription = ogDescription,
	twitterImage = ogImage,
	noindex = false,
	nofollow = false,
	lang = SITE.defaultLanguage,
} = Astro.props;

// Construct full URLs
const currentPath = Astro.url.pathname;
const canonicalPath = canonicalURL || currentPath;
const siteURL = new URL(canonicalPath, SITE.url);

// Handle image URLs - support both absolute URLs and relative paths
const getFullImageUrl = (image: string): string => {
	if (image.startsWith("http://") || image.startsWith("https://")) {
		return image;
	}
	return new URL(image, SITE.url).href;
};

const fullOgImage = getFullImageUrl(ogImage);
const fullTwitterImage = getFullImageUrl(twitterImage);

// Build robots meta content
const robotsContent = [
	noindex ? "noindex" : "index",
	nofollow ? "nofollow" : "follow",
].join(", ");
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<!-- Font: DM Sans (warm, readable sans) -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap"
			rel="stylesheet"
		/>

		<!-- Preload Critical Resources -->
		<link rel="preload" href="/favicon.svg" as="image" type="image/svg+xml" />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="robots" content={robotsContent} />
		<link rel="canonical" href={siteURL.href} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={siteURL.href} />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:image" content={fullOgImage} />
		<meta property="og:site_name" content={SITE.title} />

		<!-- Twitter -->
		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:url" content={siteURL.href} />
		<meta name="twitter:title" content={twitterTitle} />
		<meta name="twitter:description" content={twitterDescription} />
		<meta name="twitter:image" content={fullTwitterImage} />

		<!-- PostHog Analytics -->
		<PostHog />

		<!-- Google tag (gtag.js) - Conditional Load -->
		<script is:inline>
			if (localStorage.getItem("muziboo_cookie_consent") === "accepted") {
				const script = document.createElement("script");
				script.src = "https://www.googletagmanager.com/gtag/js?id=G-VBR70HS3PY";
				script.async = true;
				document.head.appendChild(script);

				window.dataLayer = window.dataLayer || [];
				function gtag() {
					dataLayer.push(arguments);
				}
				gtag("js", new Date());
				gtag("config", "G-VBR70HS3PY");
			}
		</script>
	</head>
	<body class="min-h-screen bg-muziboo-bg text-muziboo-text antialiased">
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-muziboo-gold focus:text-muziboo-bg focus:rounded-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-muziboo-gold"
		>
			Skip to main content
		</a>
		<slot />

		<!-- Cookie Consent Banner -->
		<div
			id="cookie-banner"
			class="fixed bottom-0 left-0 right-0 z-[100] bg-muziboo-bg border-t border-muziboo-border p-4 transform translate-y-full transition-transform duration-500 ease-out flex flex-col sm:flex-row items-center justify-between gap-4 shadow-2xl"
		>
			<div class="text-sm text-muziboo-text-muted max-w-3xl">
				<p>
					We use cookies to analyze site traffic and improve your experience. By
					clicking "Accept", you consent to our use of analytics cookies. Read
					our <a href="/privacy" class="text-muziboo-gold hover:underline"
						>Privacy Policy</a
					>.
				</p>
			</div>
			<div
				class="flex items-center gap-3 shrink-0 w-full sm:w-auto justify-end"
			>
				<button
					id="cookie-decline"
					class="px-4 py-2 text-sm font-medium text-muziboo-text-muted hover:text-muziboo-text transition-colors"
					>Decline</button
				>
				<button
					id="cookie-accept"
					class="px-4 py-2 text-sm font-bold bg-muziboo-gold text-muziboo-bg rounded-lg hover:bg-muziboo-text transition-colors"
					>Accept All</button
				>
			</div>
		</div>

		<script is:inline>
			document.addEventListener("DOMContentLoaded", () => {
				const banner = document.getElementById("cookie-banner");
				const acceptBtn = document.getElementById("cookie-accept");
				const declineBtn = document.getElementById("cookie-decline");

				if (!banner) return;

				if (!localStorage.getItem("muziboo_cookie_consent")) {
					setTimeout(() => {
						banner.classList.remove("translate-y-full");
					}, 500);
				}

				function hideBanner() {
					banner.classList.add("translate-y-full");
				}

				acceptBtn.addEventListener("click", () => {
					localStorage.setItem("muziboo_cookie_consent", "accepted");
					hideBanner();
					window.location.reload();
				});

				declineBtn.addEventListener("click", () => {
					localStorage.setItem("muziboo_cookie_consent", "declined");
					hideBanner();
				});
			});
		</script>
	</body>
</html>
